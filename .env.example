# Server
OPENROUTEAI_HOST=127.0.0.1
OPENROUTEAI_PORT=4000

# Optional second local OpenAI-compatible server:
# OPENROUTEAI_LOCAL_BASE_URL=http://127.0.0.1:1234/v1

# Example Ollama provider. Do not put cloud API keys in this file.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: give an installed chat model priority when model="auto".
# OPENROUTEAI_MODEL=ollama/qwen2.5-coder:7b

# Configure Ollama itself with OLLAMA_NO_CLOUD=1 for strict offline use.
